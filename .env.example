# Copy to .env.local (or run `make export-env` to generate it from CDK outputs).
# These are consumed by scripts/run-primary.sh and scripts/run-secondary.sh.

COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_abc123
COGNITO_DOMAIN_URL=https://example-demo.auth.us-east-1.amazoncognito.com
COGNITO_TOKEN_URL=https://example-demo.auth.us-east-1.amazoncognito.com/oauth2/token
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_abc123
COGNITO_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_abc123/.well-known/jwks.json
COGNITO_PRIMARY_CLIENT_ID=replace-me
COGNITO_PRIMARY_CLIENT_SECRET=replace-me
COGNITO_SCOPE=secondary/read
SECONDARY_BASE_URL=http://localhost:8082
